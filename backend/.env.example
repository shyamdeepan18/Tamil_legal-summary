# Application
DEBUG=False

# Razorpay (Get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# LLM Provider (Choose ONE - priority: Gemini > Groq > OpenAI)

# Option 1: Google Gemini Flash (FREE - RECOMMENDED)
# Get from: https://makersuite.google.com/app/apikey
# Limits: 15 requests/min, 1M tokens/day
GOOGLE_API_KEY=xxxxx

# Option 2: Groq (FREE - Very Fast)
# Get from: https://console.groq.com/
# Limits: 30 requests/min, 14,400 requests/day
# GROQ_API_KEY=xxxxx

# Option 3: OpenAI (PAID - ~₹0.15 per document)
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxx

# Supabase (Optional - for Pro features)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=xxxxx

# Redis (Optional - for caching, use Upstash free tier)
# Get from: https://upstash.com/
REDIS_HOST=xxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=xxxxx

# Encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=xxxxx
